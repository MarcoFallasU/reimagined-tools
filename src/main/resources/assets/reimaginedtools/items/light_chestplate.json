{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "body",
        "model": {
          "type": "minecraft:model",
          "model": "reimaginedtools:item/light_chestplate_body"
        }
      },
      {
        "when": "right_arm",
        "model": {
          "type": "minecraft:model",
          "model": "reimaginedtools:item/light_chestplate_right_arm"
        }
      },
      {
        "when": "left_arm",
        "model": {
          "type": "minecraft:model",
          "model": "reimaginedtools:item/light_chestplate_left_arm"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "reimaginedtools:item/light_chestplate"
    }
  }
}
